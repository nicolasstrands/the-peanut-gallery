# WebSocket endpoint for the realtime Worker (apps/realtime).
#
# Copy this file to .env and set your own endpoint. Nuxt reads .env at build
# time, so the value is baked into `pnpm dev:web`, `pnpm build:web` and
# `pnpm deploy:web`. Nothing instance-specific has to be committed.
#
# Against a locally-running Worker (`pnpm dev:realtime`):
#   NUXT_PUBLIC_REALTIME_URL=ws://localhost:8787
#
# Against your deployed Worker:
#   NUXT_PUBLIC_REALTIME_URL=wss://peanut-gallery-realtime.<your-subdomain>.workers.dev
#
# CI deploys do not read this file. Set NUXT_PUBLIC_REALTIME_URL in the
# workflow environment instead, or the build falls back to the default in
# nuxt.config.ts.
NUXT_PUBLIC_REALTIME_URL=ws://localhost:8787
